<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Entity Framework Core provider for XuguDB (虚谷数据库).</Description>
    <TargetFramework>$(XuguTargetFramework)</TargetFramework>
    <AssemblyName>Microsoft.EntityFrameworkCore.Xugu</AssemblyName>
    <RootNamespace>Microsoft.EntityFrameworkCore.Xugu</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;EF9100</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.EntityFrameworkCore.Xugu</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" flows EF Core analyzers to consuming projects -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" PrivateAssets="none" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!-- Local driver: csharp-driver-v3.3.4-cyj (Dispose(bool) fix). Override with UseLocalXuguDriver=false for NuGet. -->
  <ItemGroup Condition="'$(UseLocalXuguDriver)' != 'false'">
    <ProjectReference Include="..\..\..\csharp-driver-v3.3.4-cyj\XGCSClient\XGCSClient.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalXuguDriver)' == 'false'">
    <!-- Public nuget.org only ships prerelease builds; override for release pack validation -->
    <PackageReference Include="Xuguclient" VersionOverride="3.3.6-bionic" />
  </ItemGroup>

  <!-- Local/dev: copy native xugusql beside output for real-DB tests. -->
  <!-- Release pack (UseLocalXuguDriver=false): do NOT embed local xugusql.dll —
       consumers must use Xuguclient package native assets to avoid dual-source conflicts. -->
  <ItemGroup Condition="'$(XuguNativeDllExists)' == 'true'">
    <None Include="$(XuguNativeDllPath)">
      <Link>xugusql.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack Condition="'$(UseLocalXuguDriver)' != 'false'">true</Pack>
      <Pack Condition="'$(UseLocalXuguDriver)' == 'false'">false</Pack>
      <PackagePath>runtimes/win-x64/native/</PackagePath>
    </None>
  </ItemGroup>

  <!-- linux-x64 native: pack only when local driver mode and .so exists (PLAT-02). -->
  <ItemGroup Condition="'$(XuguNativeSoExists)' == 'true'">
    <None Include="$(XuguNativeSoPath)">
      <Link>libxugusql.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack Condition="'$(UseLocalXuguDriver)' != 'false'">true</Pack>
      <Pack Condition="'$(UseLocalXuguDriver)' == 'false'">false</Pack>
      <PackagePath>runtimes/linux-x64/native/</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\XuguStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>XuguStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\XuguStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>XuguStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>


