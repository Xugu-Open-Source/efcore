<Project>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <EFCoreXGJsonMicrosoftFile>$(IntermediateOutputPath)EFCoreXGJsonMicrosoft$(DefaultLanguageSourceExtension)</EFCoreXGJsonMicrosoftFile>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(Language)' == 'F#'">
      <Choose>
        <When Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe'">
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileBefore</CodeFragmentItemGroup>
          </PropertyGroup>
        </When>
        <Otherwise>
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileAfter</CodeFragmentItemGroup>
          </PropertyGroup>
        </Otherwise>
      </Choose>
    </When>
    <Otherwise>
      <PropertyGroup>
        <CodeFragmentItemGroup>Compile</CodeFragmentItemGroup>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <Target Name="AddEFCoreXGJsonMicrosoft"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'True'"
          Inputs="$(MSBuildAllProjects)"
          Outputs="$(EFCoreXGJsonMicrosoftFile)">
    <ItemGroup>
      <EFCoreXGJsonMicrosoftServices Include="Microsoft.EntityFrameworkCore.Design.DesignTimeServicesReferenceAttribute">
        <_Parameter1>Microsoft.EntityFrameworkCore.XuGu.Json.Microsoft.Design.Internal.XGJsonMicrosoftDesignTimeServices, Microsoft.EntityFrameworkCore.XuGu.Json.Microsoft</_Parameter1>
        <_Parameter2>Microsoft.EntityFrameworkCore.XuGu.Json.Microsoft</_Parameter2>
      </EFCoreXGJsonMicrosoftServices>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(EFCoreXGJsonMicrosoftServices)"
                       Language="$(Language)"
                       OutputFile="$(EFCoreXGJsonMicrosoftFile)">
      <Output TaskParameter="OutputFile" ItemName="$(CodeFragmentItemGroup)" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>