<Project>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <EFCoreXGJsonNewtonsoftFile>$(IntermediateOutputPath)EFCoreXGJsonNewtonsoft$(DefaultLanguageSourceExtension)</EFCoreXGJsonNewtonsoftFile>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(Language)' == 'F#'">
      <Choose>
        <When Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe'">
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileBefore</CodeFragmentItemGroup>
          </PropertyGroup>
        </When>
        <Otherwise>
          <PropertyGroup>
            <CodeFragmentItemGroup>CompileAfter</CodeFragmentItemGroup>
          </PropertyGroup>
        </Otherwise>
      </Choose>
    </When>
    <Otherwise>
      <PropertyGroup>
        <CodeFragmentItemGroup>Compile</CodeFragmentItemGroup>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <Target Name="AddEFCoreXGJsonNewtonsoft"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'True'"
          Inputs="$(MSBuildAllProjects)"
          Outputs="$(EFCoreXGJsonNewtonsoftFile)">
    <ItemGroup>
      <EFCoreXGJsonNewtonsoftServices Include="Microsoft.EntityFrameworkCore.Design.DesignTimeServicesReferenceAttribute">
        <_Parameter1>Microsoft.EntityFrameworkCore.XuGu.Json.Newtonsoft.Design.Internal.XGJsonNewtonsoftDesignTimeServices, Microsoft.EntityFrameworkCore.XuGu.Json.Newtonsoft</_Parameter1>
        <_Parameter2>Microsoft.EntityFrameworkCore.XuGu.Json.Newtonsoft</_Parameter2>
      </EFCoreXGJsonNewtonsoftServices>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(EFCoreXGJsonNewtonsoftServices)"
                       Language="$(Language)"
                       OutputFile="$(EFCoreXGJsonNewtonsoftFile)">
      <Output TaskParameter="OutputFile" ItemName="$(CodeFragmentItemGroup)" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>